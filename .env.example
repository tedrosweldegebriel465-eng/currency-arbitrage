# Optional future settings. The current application does not require these
# variables; they document the intended configuration surface for later phases.

CURRENCY_ARBITRAGE_ENV=development
CURRENCY_ARBITRAGE_LOG_LEVEL=INFO

# SQLite path used by monitoring persistence (default matches current code)
CURRENCY_ARBITRAGE_DB_PATH=data/arbitrage_history.db

# Detection thresholds (current in-code defaults shown)
CURRENCY_ARBITRAGE_PROFIT_THRESHOLD=0.0001
CURRENCY_ARBITRAGE_NUM_CURRENCIES=25

# Live provider cache duration in seconds (current in-code default is 60)
CURRENCY_ARBITRAGE_CACHE_DURATION=60

# Monitoring
CURRENCY_ARBITRAGE_MONITOR_INTERVAL_SECONDS=2
CURRENCY_ARBITRAGE_ALERT_PROFIT_THRESHOLD=0.1

# Do not put API keys or secrets in source control.
# CURRENCY_ARBITRAGE_API_KEY=
